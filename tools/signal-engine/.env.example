ALPHA_VANTAGE_API_KEY=your_key_here
NEWS_API_KEY=your_key_here
POLYGON_API_KEY=your_key_here
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Free — paper-trading account, no card, at alpaca.markets. Unblocks real OFI
# (and partial dark-pool trade data, but not TRF tagging) when Polygon's free
# tier doesn't cover quotes/trades. Optional — everything degrades gracefully
# without it.
ALPACA_API_KEY_ID=your_key_here
ALPACA_API_SECRET_KEY=your_secret_here
