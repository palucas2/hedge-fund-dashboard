# Auth
NEXTAUTH_SECRET=<générer avec: openssl rand -base64 32>
NEXTAUTH_URL=http://localhost:3000

# Base de données
DATABASE_URL=postgresql://user:password@neon.tech/hedge_fund_db

# APIs de données
# Alpha Vantage : fondamentaux Company (Antecede) + Earnings Surprises (Module 9) uniquement —
# les cotations/volume/intraday tournent sur Yahoo Finance, gratuit et sans clé.
ALPHA_VANTAGE_KEY=<clé Alpha Vantage>
NEWS_API_KEY=<clé NewsAPI.org>
# Polygon.io n'est plus utilisé — Yahoo Finance + CoinGecko couvrent tout ce qui lui était destiné.

# IA
ANTHROPIC_API_KEY=<clé Anthropic>
MARKET_RECAP_PROMPT=<prompt complet du format Market Recap>

# Pas de clé nécessaire pour la carte (Module 1) — MapLibre GL + OpenFreeMap, gratuit et sans compte.

# TradingView (optionnel — lien vers le script Markov une fois publié, Module 5)
NEXT_PUBLIC_MARKOV_SCRIPT_URL=
